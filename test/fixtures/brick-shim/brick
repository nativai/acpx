#!/usr/bin/env node
import fs from "node:fs";

const args = process.argv.slice(2);
const verb = args[0] ?? "";
const logPath = process.env.BRICK_SHIM_LOG;
if (logPath) {
  fs.appendFileSync(logPath, `${JSON.stringify(args)}\n`, "utf8");
}

function modeForVerb() {
  if (verb === "context" && process.env.BRICK_SHIM_CONTEXT_MODE) {
    return process.env.BRICK_SHIM_CONTEXT_MODE;
  }
  return process.env.BRICK_SHIM_MODE ?? "ok";
}

// C7: when set, record what identity env the shim was spawned with (null = ABSENT), so a test
// can assert the child's session and seat reach `brick` through env, not through flags.
const envLogPath = process.env.BRICK_SHIM_ENV_LOG;
if (envLogPath) {
  const has = (name) => (Object.hasOwn(process.env, name) ? process.env[name] : null);
  fs.appendFileSync(
    envLogPath,
    `${JSON.stringify({ verb, ACPX_SESSION_URL: has("ACPX_SESSION_URL"), ACPX_SEAT_URL: has("ACPX_SEAT_URL") })}\n`,
    "utf8",
  );
}

// C7: BRICK_SHIM_REMOTE_PARSE=1 reproduces what the REAL acpx-ui brick CLI does in HTTP/remote mode
// (brick/cli-remote.ts `dispatchRemoteBrick`): `new URL(env.ACPX_SESSION_URL).searchParams.get("session")`
// on EVERY verb. A bare uuid throws "Invalid URL" and the CLI exits 1 — which blanks the brick block.
if (process.env.BRICK_SHIM_REMOTE_PARSE) {
  try {
    if (process.env.ACPX_SESSION_URL) {
      new URL(process.env.ACPX_SESSION_URL).searchParams.get("session");
    }
    if (process.env.ACPX_SEAT_URL) {
      new URL(process.env.ACPX_SEAT_URL).searchParams.get("seat");
    }
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
    process.exit(1);
  }
}

const mode = modeForVerb();
if (mode === "hang") {
  setTimeout(() => {}, 30_000);
} else if (mode === "not-found") {
  process.exit(3);
} else if (mode === "ambiguous") {
  process.exit(5);
} else if (mode === "garbage") {
  process.stdout.write("not json");
} else if (mode === "crash") {
  process.stderr.write("shim crash\n");
  process.exit(1);
} else if (verb === "show") {
  const id = process.env.BRICK_SHIM_ID ?? "11111111-2222-3333-4444-555555555555";
  const brickPath = process.env.BRICK_SHIM_PATH ?? `/tmp/brick-shim/${id}`;
  // A real `brick show` of a container brick is a 4-12 MB card (measured 2026-10-03: 0d2b83f0
  // 4.1 MB, a2d3967c 12.4 MB). BRICK_SHIM_CARD_BYTES pads THIS verb only, as the real CLI does:
  // the lean `context --json` below stays small.
  const padding = "x".repeat(Number(process.env.BRICK_SHIM_CARD_BYTES ?? 0));
  process.stdout.write(
    JSON.stringify({ ok: true, data: { brick: { id, path: brickPath }, parts: padding } }),
  );
} else if (verb === "stamp") {
  process.exit(0);
} else if (verb === "context" && args.includes("--json")) {
  // The lean resolve `acpx` validates a ref with: the same `data.brick` as `show`, no card.
  const id = process.env.BRICK_SHIM_ID ?? "11111111-2222-3333-4444-555555555555";
  const brickPath = process.env.BRICK_SHIM_PATH ?? `/tmp/brick-shim/${id}`;
  process.stdout.write(JSON.stringify({ ok: true, data: { brick: { id, path: brickPath } } }));
} else if (verb === "context") {
  if (process.env.BRICK_SHIM_CONTEXT_FILE) {
    process.stdout.write(fs.readFileSync(process.env.BRICK_SHIM_CONTEXT_FILE));
  } else {
    process.stdout.write(process.env.BRICK_SHIM_CONTEXT ?? "BRICK CONTEXT BLOCK");
  }
} else {
  process.stderr.write(`unknown verb: ${verb}\n`);
  process.exit(2);
}
