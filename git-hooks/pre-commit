#!/bin/sh
#
# acpx-shipped `pre-commit` — CHAIN TO THE REPO'S OWN HOOK (brick e1d6ee4c).
#
# ## The defect this closes
#
# acpx env-scopes `core.hooksPath` to this directory (`src/acp/auth-env.ts`,
# `applyGitCommitAttribution`) so that the shipped `prepare-commit-msg` runs and
# stamps `Session:` / `Brick:` / `Seat:` trailers on agent commits. The redirect is
# wholesale: git then looks for EVERY hook here, and this directory held exactly
# one. So a repo's own `pre-commit` — a formatter, a linter — was silently
# skipped for every agent commit on the box, while still firing for every HUMAN
# commit in the same repo.
#
# ⚠️ NOTE THE SHAPE, because it is the reason this file exists. The hook was
# configured, present and passing. Nothing reported it inert for the commits that
# make up most of the traffic. It surfaced only as a `format:check` red in an
# unrelated lane's gate, on a file that lane's commit never touched — i.e. as
# somebody else's failure landing in your diff. `docs/sessions.md` was the live
# instance and cost several lanes a differential each.
#
# ## Why chain here rather than fix the one repo
#
# The redirect applies to EVERY repo on the box, so a per-repo fix leaves every
# other repo pre-armed: the trap fires the day someone adds a formatter, and the
# first symptom is that same unattributable red, months later. Measured
# 2026-09-06 across the 39 repos under `/workspace/projects/`: exactly ONE has a
# live `pre-commit` (acpx's own husky hook), one more is dormant (a lefthook shim
# in a bare repo with no worktrees), and NONE is interactive. acpx's costs ~8 s
# warm (`lint-staged` ~2.2 s + `build` ~5.5 s). Chaining is therefore in
# proportion; the 37 repos with no hook pay only the two `git config` reads below.
#
# ## The two properties this must have, and both are load-bearing
#
#   1. **Silent and exit 0 when the repo has no hook.** That is the common case.
#   2. **NEVER swallow the repo hook's exit code.** A chaining hook that always
#      exits 0 recreates the exact defect it removes, while looking fixed.
#
# `prepare-commit-msg` in this directory is untouched and unaffected.

set -u

# ── 1. Where WOULD git have looked, had acpx not redirected it here? ──────────
#
# ⚠️ NOT `git rev-parse --git-path hooks`. Measured 2026-09-06: that HONOURS
# `core.hooksPath`, so under acpx's redirect it returns THIS directory — chaining
# to it would exec this file again, forever. The repo's own answer is its FILE
# config (the `GIT_CONFIG_*` env override acpx sets does not leak into `--local`
# / `--global` / `--system`, measured), falling back to the git common dir.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -n "$top" ] || exit 0

hooks_dir=$(git config --local --get core.hooksPath 2>/dev/null) || hooks_dir=""
[ -n "$hooks_dir" ] || hooks_dir=$(git config --global --get core.hooksPath 2>/dev/null) || hooks_dir=""
[ -n "$hooks_dir" ] || hooks_dir=$(git config --system --get core.hooksPath 2>/dev/null) || hooks_dir=""

if [ -n "$hooks_dir" ]; then
	# A relative `core.hooksPath` is resolved against the working-tree root.
	case "$hooks_dir" in
	/*) ;;
	*) hooks_dir="$top/$hooks_dir" ;;
	esac
else
	common=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0
	[ -n "$common" ] || exit 0
	case "$common" in
	/*) ;;
	*) common="$top/$common" ;;
	esac
	hooks_dir="$common/hooks"
fi

repo_hook="$hooks_dir/pre-commit"

# The common case — 37 of 39 repos on this box. Silent, and two `git config`
# reads is the whole cost.
[ -f "$repo_hook" ] || exit 0

# ── 2. Never exec ourselves ──────────────────────────────────────────────────
#
# Belt to the braces above: if a repo ever configures `core.hooksPath` AT this
# directory, the resolution above returns this very file.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) || self_dir=""
hook_dir=$(CDPATH= cd -- "$(dirname -- "$repo_hook")" 2>/dev/null && pwd -P) || hook_dir=""
if [ -n "$self_dir" ] && [ "$self_dir/$(basename -- "$0")" = "$hook_dir/$(basename -- "$repo_hook")" ]; then
	exit 0
fi

# ── 3. Run it exactly as git would have ──────────────────────────────────────
#
# git runs hooks from the working-tree root; be explicit rather than inherit it.
# A failure to get there is a REFUSAL, not a skip — silently passing here would
# be the swallow this file exists to prevent.
cd "$top" || exit 1

if [ -x "$repo_hook" ]; then
	set -- "$repo_hook" "$@"
else
	# husky v9 does not require the mode bit; it runs its hooks through `sh`.
	set -- sh "$repo_hook" "$@"
fi

# stdin is closed deliberately. git gives `pre-commit` no stdin, and an agent has
# no terminal to answer a prompt on — so a hook that reads one FAILS here instead
# of wedging every commit the box makes.
#
# The timeout is the same reasoning one step out: the repos this chaining exists
# to protect are precisely the ones with no hook yet, i.e. the ones nobody has
# inspected. On expiry it REFUSES the commit loudly (exit 124) rather than
# passing it — a timeout that exits 0 would be the swallow again, in a costume.
timeout_s=${ACPX_HOOK_TIMEOUT:-300}
if [ "$timeout_s" != "0" ] && command -v timeout >/dev/null 2>&1; then
	timeout --foreground "$timeout_s" "$@" </dev/null
	rc=$?
	if [ "$rc" -eq 124 ]; then
		echo "acpx: the repo's pre-commit hook exceeded ${timeout_s}s and was killed:" >&2
		echo "acpx:   $repo_hook" >&2
		echo "acpx: the commit is REFUSED. Raise ACPX_HOOK_TIMEOUT, set it to 0 to disable" >&2
		echo "acpx: the bound, or commit with --no-verify." >&2
	fi
	exit "$rc"
fi

"$@" </dev/null
exit $?
